# Database
DATABASE_URL=sqlite:///./kyc_voice_lab.db

# Speech model
WHISPER_MODEL_SIZE=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Audio uploads
AUDIO_UPLOAD_DIR=./audio_uploads
MAX_AUDIO_SIZE_MB=25
RETAIN_AUDIO=false

# Server
HOST=127.0.0.1
PORT=8000

# CORS
CORS_ORIGINS=http://localhost:3000

# Verification
MAX_RETRIES_PER_QUESTION=3
